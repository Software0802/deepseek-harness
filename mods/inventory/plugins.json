  "environment": {
    "notes": {
      "node": "homebrew node@22 broken (missing simdjson lib) — use DSH bundled node",
      "bundledNode": "~/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node",
      "bundledPnpm": "~/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/pnpm/bin/pnpm.mjs"
    },
    "checks": [
      {
        "id": "node",
        "name": "node >= 22.5",
        "kind": "command",
        "command": "node --version",
        "prefer": "~/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node",
        "versionGte": "22.5",
        "remedy": "use DSH bundled node: export PATH=\"$HOME/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin:$PATH\""
      },
      {
        "id": "zstd",
        "name": "zstd",
        "kind": "command",
        "command": "zstd --version",
        "remedy": "brew install zstd"
      },
      {
        "id": "dsh-app",
        "name": "DeepSeek Harness.app",
        "kind": "path",
        "path": "/Applications/DeepSeek Harness.app",
        "remedy": "install desktop app to /Applications"
      },
      {
        "id": "dsh-profile",
        "name": "desktop profile initialized",
        "kind": "path",
        "path": "~/.dsh/profiles/desktop/package.json",
        "remedy": "open DeepSeek Harness.app once, then Cmd+Q"
      },
      {
        "id": "acpx",
        "name": "acpx",
        "kind": "commandOrLocal",
        "command": "acpx --version",
        "localPath": "../.tools/node_modules/.bin/acpx",
        "remedy": "npm i -g acpx  OR  cd ../.tools && npm i acpx"
      },
      {
        "id": "lavish-axi",
        "name": "lavish-axi (apply UI)",
        "kind": "commandOrLocal",
        "command": "lavish-axi --version",
        "localPath": "../.tools/node_modules/.bin/lavish-axi",
        "remedy": "npm i -g lavish-axi  OR  cd ../.tools && npm i lavish-axi"
      },
      {
        "id": "cli-claude",
        "name": "cli: claude",
        "kind": "command",
        "command": "which claude",
        "loggedIn": true,
        "remedy": "install claude"
      },
      {
        "id": "cli-codex",
        "name": "cli: codex",
        "kind": "command",
        "command": "which codex",
        "remedy": "install codex"
      },
      {
        "id": "cli-opencode",
        "name": "cli: opencode",
        "kind": "command",
        "command": "which opencode",
        "remedy": "install opencode"
      },
      {
        "id": "cli-grok",
        "name": "cli: grok",
        "kind": "command",
        "command": "which grok",
        "remedy": "install grok"
      },
      {
        "id": "cli-cursor-agent",
        "name": "cli: cursor-agent",
        "kind": "command",
        "command": "which cursor-agent",
        "remedy": "install cursor-agent"
      },
      {
        "id": "cli-hermes",
        "name": "cli: hermes",
        "kind": "command",
        "command": "which hermes",
        "remedy": "install hermes"
      },
      {
        "id": "agent-logged-in",
        "name": "≥1 agent harness logged in",
        "kind": "aggregate",
        "anyOf": ["cli-claude", "cli-codex", "cli-opencode", "cli-grok", "cli-cursor-agent", "cli-hermes"],
        "remedy": "login one of: claude / codex / opencode / grok / cursor-agent / hermes"
      },
      {
        "id": "backpass-fork",
        "name": "backpass fork",
        "kind": "path",
        "path": "mods/features/backpass/bin/backpass.js",
        "remedy": "clone deepseek-harness mods/features/backpass"
      },
      {
        "id": "backpass-deps",
        "name": "backpass deps installed",
        "kind": "path",
        "path": "mods/features/backpass/node_modules",
        "remedy": "cd mods/features/backpass && pnpm install"
      },
      {
        "id": "skill-backpass-weekly",
        "name": "backpass-weekly skill",
        "kind": "path",
        "path": "mods/skills/backpass-weekly/SKILL.md",
        "remedy": "present in mods/skills"
      },
      {
        "id": "sync-script",
        "name": "inventory sync.mjs",
        "kind": "path",
        "path": "mods/inventory/sync.mjs",
        "remedy": "present"
      }
    ]
  },
  "localTools": [
    {
      "id": "backpass",
      "path": "mods/features/backpass",
      "source": "fork: https://github.com/kunchenguid/backpass",
      "version": "0.1.43+dsh",
      "purpose": "AGENTS.md 反向传播训练：读本地 agent 会话 transcript，提议证据化编辑。含本仓库维护的 DSH adapter",
      "license": "MIT",
      "install": "cd mods/features/backpass && pnpm install && node bin/backpass.js",
      "requires": ["node>=22.5", "zstd", "acpx", "lavish-axi(可选, apply review UI)"],
      "skill": "mods/skills/backpass-weekly — 每周反向传播流程封装"
    }
  ]
}